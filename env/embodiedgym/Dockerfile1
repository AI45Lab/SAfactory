# 1. 指定基础镜像
FROM registry.h.pjlab.org.cn/ailab-evobox-evobox_cpu/ray:base

# ENV PIP_INDEX_URL="http://mirrors.i.h.pjlab.org.cn/pypi/simple/" \
#     PIP_EXTRA_INDEX_URL="http://pypi.i.h.pjlab.org.cn/brain/dev/+simple" \
#     PIP_TRUSTED_HOST="mirrors.i.h.pjlab.org.cn pypi.i.h.pjlab.org.cn"

# ----------------- 网络代理设置 -----------------
# 确保你的代理信息是正确的
ENV http_proxy=http://leishanzhe:wSl49KRSqn71Jkqikb8tfZ8Lqxx5uGCgIEmiBGuDzH5r6uSpEN3nGLmsO7UE@proxy.h.pjlab.org.cn:23128
ENV https_proxy=http://leishanzhe:wSl49KRSqn71Jkqikb8tfZ8Lqxx5uGCgIEmiBGuDzH5r6uSpEN3nGLmsO7UE@proxy.h.pjlab.org.cn:23128

# 设置工作目录
WORKDIR /workspace

# 切换到 root 用户以进行安装
USER root

# 2. 安装系统级依赖
RUN apt-get update && apt-get install -y \
    xvfb \
    fonts-ubuntu \
    && rm -rf /var/lib/apt/lists/*

# 2.1. 安装 Miniconda
# 注意：构建时请确保 Docker 可以访问这个宿主机路径
# Step 7 & 8 Combined: Download and install the LATEST Miniconda
RUN apt-get update && apt-get install -y wget && \
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/miniconda3 && \
    rm /tmp/miniconda.sh && \
    apt-get remove -y wget && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# 将 Miniconda 添加到 PATH 环境变量
ENV PATH="/opt/miniconda3/bin:${PATH}"

# 3. 复制项目文件
# 注意这里的路径，它们现在是相对于 gzk/ 目录的
COPY ./ai2thor/.ai2thor /root/.ai2thor
COPY ./AIEvoBox ./AIEvoBox
