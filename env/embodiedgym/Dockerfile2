# 1. 指定基础镜像
FROM registry.h.pjlab.org.cn/ailab-evobox-evobox_cpu/ray:base

# ENV PIP_INDEX_URL="http://mirrors.i.h.pjlab.org.cn/pypi/simple/" \
#     PIP_EXTRA_INDEX_URL="http://pypi.i.h.pjlab.org.cn/brain/dev/+simple" \
#     PIP_TRUSTED_HOST="mirrors.i.h.pjlab.org.cn pypi.i.h.pjlab.org.cn"

# ----------------- 网络代理设置 -----------------
# 确保你的代理信息是正确的
ENV http_proxy=http://leishanzhe:wSl49KRSqn71Jkqikb8tfZ8Lqxx5uGCgIEmiBGuDzH5r6uSpEN3nGLmsO7UE@proxy.h.pjlab.org.cn:23128
ENV https_proxy=http://leishanzhe:wSl49KRSqn71Jkqikb8tfZ8Lqxx5uGCgIEmiBGuDzH5r6uSpEN3nGLmsO7UE@proxy.h.pjlab.org.cn:23128

# 设置工作目录
WORKDIR /workspace

# 切换到 root 用户以进行安装
USER root

# 2. 安装系统级依赖
RUN apt-get update && apt-get install -y \
    xvfb \
    fonts-ubuntu \
    && rm -rf /var/lib/apt/lists/*

# 2.1. 安装 Miniconda
# 注意：构建时请确保 Docker 可以访问这个宿主机路径
# Step 7 & 8 Combined: Download and install the LATEST Miniconda
RUN apt-get update && apt-get install -y wget && \
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/miniconda3 && \
    rm /tmp/miniconda.sh && \
    apt-get remove -y wget && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# 将 Miniconda 添加到 PATH 环境变量
ENV PATH="/opt/miniconda3/bin:${PATH}"

# 3. 复制项目文件
# 注意这里的路径，它们现在是相对于 gzk/ 目录的
COPY ./ai2thor/.ai2thor /root/.ai2thor
COPY ./AIEvoBox ./AIEvoBox

# 4. 使用 Conda 创建环境
# 注意：确保 EmbodiedBench-master 里的 conda 文件路径正确
# Step 12: 创建配置文件以自动接受 Anaconda 的服务条款
RUN echo "anaconda_tos_accepted: true" > /root/.condarc

# Step 13: 现在可以安全地创建环境了
RUN cd AIEvoBox/env/embodiedgym/EmbodiedBench-master && \
    conda env create -f conda_envs/envir.yaml --prefix /root/envs/embench1

# 在新创建的环境中安装项目
RUN /bin/bash -c "source /opt/miniconda3/etc/profile.d/conda.sh && \
    conda activate /root/envs/embench1 && \
    cd AIEvoBox/env/embodiedgym/EmbodiedBench-master && \
    pip install -e ."

WORKDIR /workspace/AIEvoBox

expose 36663

# 5. 设置默认的启动命令（已修改）
# 在激活环境后，启动 Xvfb 虚拟桌面，并设置 DISPLAY 环境变量
CMD ["/bin/bash", "-c", "source /opt/miniconda3/etc/profile.d/conda.sh && conda activate /root/envs/embench1 && Xvfb :1 -screen 0 1024x768x24 & export DISPLAY=:1 && bash /workspace/AIEvoBox/examples/run_8_embodied_envs.sh"]