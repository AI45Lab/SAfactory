# ===========================================
# AIEvoBox RL Environment Variables
# ===========================================

# -------------------------------------------
# Common Settings
# -------------------------------------------
export AIEVOBOX_ROOT=/root/AIEvoBox
export AIEVOBOX_DB_URL=sqlite:///${AIEVOBOX_ROOT}/rl/rl.db

# -------------------------------------------
# RL Core Settings (used by multiple components)
# -------------------------------------------
export RL_ENV_NUM=5
export RL_MAX_STEPS=10
export RL_API_KEY=openai_api_key
export RL_MODEL=model

# -------------------------------------------
# Rollout Settings
# -------------------------------------------
export ROLLOUT_MAX_WORKERS=200

# -------------------------------------------
# Buffer Server Settings
# -------------------------------------------
# HOST is for other services to connect (server always listens on 0.0.0.0)
export BUFFER_SERVER_HOST=127.0.0.1
export BUFFER_SERVER_PORT=18889

# -------------------------------------------
# LLM Proxy Settings
# -------------------------------------------
# HOST is for other services to connect (server always listens on 0.0.0.0)
export LLM_PROXY_HOST=127.0.0.1
export LLM_PROXY_PORT=18890
export LLM_MAX_LENGTH=4608

# -------------------------------------------
# Rollout Buffer (SLIME) Settings
# -------------------------------------------
# Set to "True" to clear served data on restart, "False" to resume
export ROLLBUF_RESTART_TRAINING=True

# -------------------------------------------
# Slime Training Settings (reference RL values)
# -------------------------------------------
export SLIME_N_SAMPLES_PER_PROMPT=$RL_ENV_NUM
export SLIME_GLOBAL_BATCH_SIZE=480
export SLIME_ROLLOUT_BATCH_SIZE=$((SLIME_GLOBAL_BATCH_SIZE / RL_ENV_NUM))
# 允许的最大权重版本差，0 表示只使用当前版本的数据
export RL_OFF_BY_N=0
