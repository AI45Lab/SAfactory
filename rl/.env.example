# ===========================================
# AIEvoBox RL Environment Variables
# ===========================================

# -------------------------------------------
# Common Settings
# -------------------------------------------
export AIEVOBOX_ROOT=/root/AIEvoBox
export AIEVOBOX_DB_URL=sqlite:///${AIEVOBOX_ROOT}/rl/rl.db

# -------------------------------------------
# Buffer Server Settings
# -------------------------------------------
export BUFFER_SERVER_HOST=0.0.0.0
export BUFFER_SERVER_PORT=8889
export ROLLOUT_BUFFER_URL=http://127.0.0.1:8889

# -------------------------------------------
# LLM Proxy Settings
# -------------------------------------------
export LLM_PROXY_HOST=0.0.0.0
export LLM_PROXY_PORT=8890
export LLM_PROXY_URL=http://127.0.0.1:8890

# -------------------------------------------
# AIEvoBox Runner Settings
# -------------------------------------------
export ROLLOUT_BATCH_SIZE=256
export ROLLOUT_MAX_STEPS=10
export NUM_REPEAT_PER_SAMPLE=5
export OPENAI_API_KEY=openai_api_key
export AIEVOBOX_MODEL=model

# -------------------------------------------
# Rollout Buffer (SLIME) Settings
# -------------------------------------------
# Set to "True" to clear served data on restart, "False" to resume
export ROLLBUF_RESTART_TRAINING=True

# -------------------------------------------
# Slime Training Settings
# -------------------------------------------
export SLIME_ROLLOUT_BATCH_SIZE=$ROLLOUT_BATCH_SIZE
export SLIME_N_SAMPLES_PER_PROMPT=$NUM_REPEAT_PER_SAMPLE
export SLIME_GLOBAL_BATCH_SIZE=$ROLLOUT_BATCH_SIZE